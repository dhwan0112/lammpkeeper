########################
## Molecular dynamics ##
########################
compute mdtemp all temp
compute_modify mdtemp dynamic/dof yes
# NPT
fix heat all npt temp ${Tstar} ${Tstar} $(100.0*dt) aniso ${Press} ${Press} $(1000.0*dt)
fix heat all npt temp 1200 ${Tstar} $(100.0*dt) aniso ${Press} ${Press} $(1000.0*dt)
fix heat all npt temp 1200 1200 $(100.0*dt) aniso ${Press} ${Press} $(1000.0*dt)
fix heat all npt temp 1200 1200 0.10000000000000000555 aniso ${Press} ${Press} $(1000.0*dt)
fix heat all npt temp 1200 1200 0.10000000000000000555 aniso 10 ${Press} $(1000.0*dt)
fix heat all npt temp 1200 1200 0.10000000000000000555 aniso 10 10 $(1000.0*dt)
fix heat all npt temp 1200 1200 0.10000000000000000555 aniso 10 10 1
# NVT
##fix heat all nvt temp ${Tstar} ${Tstar} $(100.0*dt)
fix_modify heat temp mdtemp

thermo ${dumpEvery}
thermo 10
thermo_style custom step pe ke temp press

dump 1 all custom ${dumpEvery} traj.dump id element x y z
dump 1 all custom 10 traj.dump id element x y z
dump_modify 1 element Fe Mn O

run ${NStep}
run 2000
