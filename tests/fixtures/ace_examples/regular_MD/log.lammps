## Molecular dynamics ##
########################
compute mdtemp all temp
compute_modify mdtemp dynamic/dof yes
# NPT
fix heat all npt temp ${Tstar} ${Tstar} $(100.0*dt) aniso ${Press} ${Press} $(1000.0*dt)
fix heat all npt temp 1200 ${Tstar} $(100.0*dt) aniso ${Press} ${Press} $(1000.0*dt)
fix heat all npt temp 1200 1200 $(100.0*dt) aniso ${Press} ${Press} $(1000.0*dt)
fix heat all npt temp 1200 1200 0.10000000000000000555 aniso ${Press} ${Press} $(1000.0*dt)
