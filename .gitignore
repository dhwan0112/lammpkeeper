# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
build/
dist/
.venv/
venv/

# Native parser build (native/build.sh)
native/target/
lammps_post/*.so

# LAMMPS run outputs the tool generates (never in the repo tree, but just in case)
*.lammpstrj
*.restart
log.lammps
lammps-post_output/

# ...except the ACE reference example bundle shipped as test fixtures.
# The RDF/MSD/spin golden regression in tests/ reads tests/fixtures/.../traj.dump;
# without it the numeric checks silently skip.
!tests/fixtures/**
